# ============================================
# CryptoMind — Variables de entorno del SERVIDOR
# Copia este archivo como .env y llena los valores
# ============================================

PORT=3001

# Secreto para firmar JWT — genera uno aleatorio largo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

# ===== APIs =====
GROQ_API_KEY=
COINGECKO_API_KEY=

# ===== CRON =====
SIGNAL_CRON=0 */6 * * *
DAILY_SUMMARY_CRON=0 9 * * *
TIMEZONE=America/Mexico_City

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== URLs =====
# En producción: BACKEND_URL = URL de Railway, FRONTEND_URL = URL de Vercel
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ===== SUPABASE =====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===== STRIPE =====
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ===== EMAIL via Brevo API (recomendado — funciona en Render) =====
BREVO_API_KEY=
EMAIL_FROM=

# ===== SMTP (alternativa; Render free lo bloquea) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
