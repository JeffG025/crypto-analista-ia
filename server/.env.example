# ============================================
# CryptoMind — Variables de entorno del SERVIDOR
# Copia este archivo como .env y llena los valores
# ============================================

PORT=3001

# Secreto para firmar JWT — genera uno aleatorio largo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_URL=

# En local el bot y los jobs están apagados (arrancarlos borra el webhook de
# producción y manda mensajes reales). Ponlo en true solo si quieres probarlos.
ENABLE_BOT=false

# ===== APIs =====
GROQ_API_KEY=
COINGECKO_API_KEY=

# Datos de acciones (EODHD). La vertical de bolsa NO funciona sin esto.
# OJO: el tier gratuito de los proveedores de datos de mercado prohíbe el uso comercial;
# como CryptoMind cobra suscripción, hace falta un plan de pago (~$20 USD/mes). Ver docs/ADR-001.
EODHD_API_TOKEN=

# ===== CRON =====
SIGNAL_CRON=0 */6 * * *
DAILY_SUMMARY_CRON=0 9 * * *
TIMEZONE=America/Mexico_City

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== URLs =====
# En producción: BACKEND_URL = URL de Railway, FRONTEND_URL = URL de Vercel
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ===== SUPABASE =====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===== STRIPE =====
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ===== EMAIL via Brevo API (recomendado — funciona en Render) =====
BREVO_API_KEY=
EMAIL_FROM=

# ===== SMTP (alternativa; Render free lo bloquea) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== X / TWITTER (auto-publicación de contenido) =====
# developer.x.com → Projects & Apps → crea app → permisos "Read and Write"
# → Keys and tokens: API Key/Secret + Access Token/Secret (regenera el token TRAS poner Read+Write)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Hora del tweet diario (cron, en TIMEZONE). Default 13:00.
MARKETING_CRON=0 13 * * *
# true = publica solo sin revisar; false (default) = manda al admin a aprobar con un tap
TWITTER_AUTO_PUBLISH=false
